FROM quay.io/fenicsproject/stable:current

# Set working directory inside the container
WORKDIR /workspace

# Install system dependencies for data serialization and networking
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    libhdf5-dev \
    && rm -rf /var/lib/apt/lists/*

# Install python packages for data export and schema validation
RUN pip3 install --no-cache-dir \
    h5py \
    pyyaml \
    pydantic==2.6.4

USER fenics