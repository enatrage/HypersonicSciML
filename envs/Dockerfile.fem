# envs/Dockerfile.fem
FROM mambaorg/micromamba:latest

USER root
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

USER $MAMBA_USER
WORKDIR /app

# Provision the Physics Backend (Fenics) via Conda
RUN micromamba install -y -n base -c conda-forge \
    python=3.10 \
    fenics \
    mshr \
    numpy \
    scipy \
    matplotlib \
    && micromamba clean --all --yes

ENV PATH="/opt/conda/bin:$PATH"
COPY --chown=$MAMBA_USER:$MAMBA_USER requirements.txt /app/

# Dynamically strip ML/DL and GPU packages from requirements.txt to prevent bloat
RUN grep -vE 'torch|nvidia|wandb' requirements.txt > /tmp/fem_requirements.txt && \
    pip install --no-cache-dir -r /tmp/fem_requirements.txt

CMD ["/bin/bash"]